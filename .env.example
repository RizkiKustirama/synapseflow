# ==============================================================================
# SYNAPSEFLOW - ENVIRONMENT VARIABLES TEMPLATE (VERCEL & NEON DB)
# ==============================================================================

# 1. Neon Serverless Postgres Database (Pooled Connection)
# Gunakan connection string dengan Connection Pooling aktif (-pooler) dari Neon Console
# Contoh: postgresql://username:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://username:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. Neon Serverless Postgres Database (Direct Compute Connection)
# Gunakan direct connection string (tanpa -pooler) untuk migrasi Prisma CLI / db push
# Contoh: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 3. Multi-User Authentication JWT Secret
# Kunci enkripsi sesi token HS256 minimal 32 karakter acak
# Generate dengan: openssl rand -base64 32
JWT_SECRET="ganti-dengan-string-rahasia-acak-minimal-32-karakter-panjangnya"

# 4. Domain Aplikasi
# Domain publik Vercel setelah di-deploy (atau custom domain Anda)
NEXT_PUBLIC_APP_URL="https://synapseflow.vercel.app"

# 5. Gemini AI API Key (Smart Auto-Fill Career)
# Dapatkan gratis dari Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
